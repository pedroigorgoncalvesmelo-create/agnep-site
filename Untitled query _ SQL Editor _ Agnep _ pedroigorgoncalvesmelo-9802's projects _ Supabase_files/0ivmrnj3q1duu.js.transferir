        ${i&&r?s.safeSql`where (index_advisor_result->>'has_suggestion')::boolean = true`:s.safeSql``}
        ${a||s.safeSql`order by total_time desc`}
        limit ${(0,s.literal)(o)} offset ${(0,s.literal)(l)}`}},slowQueriesCount:{queryType:"db",safeSql:()=>s.safeSql`
        -- reports-query-performance-slow-queries-count
        set search_path to public, extensions;


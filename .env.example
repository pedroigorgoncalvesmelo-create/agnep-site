# ============================================================
# AGNEP — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha com seus dados do Supabase.
# Acesse: https://supabase.com/dashboard/project/seu-projeto/settings/api
# ============================================================

# URL do seu projeto Supabase (ex: https://xxxxx.supabase.co)
SUPABASE_URL="https://seu-projeto.supabase.co"

# Chave pública (anon key) — encontre em Settings > API > Project API keys
SUPABASE_PUBLISHABLE_KEY="sua-chave-anon-aqui"

# ID do projeto Supabase
SUPABASE_PROJECT_ID="seu-project-id"

# ============================================================
# Variáveis do Vite (prefixo VITE_ é obrigatório)
# ============================================================
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-anon-aqui"
VITE_SUPABASE_PROJECT_ID="seu-project-id"
